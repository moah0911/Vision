{
  "name": "vision-privacy-agent",
  "version": "0.1.0",
  "description": "Privacy-preserving on-device visual perception browser agent - Lightweight Vision Transformer + PII redaction",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt --browser firefox",
    "build": "wxt build",
    "build:firefox": "wxt build --browser firefox",
    "zip": "wxt zip",
    "submit": "wxt submit",
    "server:dev": "uvicorn server.app:app --reload --port 8000",
    "server:install": "pip install -r server/requirements.txt",
    "test:e2e": "node scripts/e2e-test.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.0",
    "@webext-core/messaging": "^2.0.1"
  },
  "devDependencies": {
    "wxt": "^0.20.15",
    "typescript": "^5.7.3",
    "@types/chrome": "^0.1.9"
  }
}
