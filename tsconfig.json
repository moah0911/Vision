{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // The popup, content script and offscreen document use the callback-style `chrome.*` API
    // directly, so the Chrome type definitions are still needed alongside WXT's auto-imports.
    "types": ["chrome"]
  },
  // `.wxt/wxt.d.ts` is generated by WXT and carries the `defineBackground` / `defineContentScript`
  // / `browser` auto-import globals. It must stay in the program or every entrypoint fails to
  // resolve them.
  "include": ["entrypoints", "modules", "components", ".wxt/wxt.d.ts", ".wxt/types"],
  "exclude": ["node_modules", ".output", ".wxt/types/i18n.d.ts"]
}
